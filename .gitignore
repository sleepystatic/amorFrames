# Full-resolution originals. Never served to browsers, never committed --
# they are what blew the Render bandwidth limit. They live outside static/
# so the static build can't sweep 2.5 GB into build/. Keep your own backup;
# regenerate the served derivatives with: python scripts/optimize_images.py
originals/

# Static build output -- regenerate with: python freeze.py
build/

