# Cloudflare Pages response headers. Copied to the build root by freeze.py.
# https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# Every static URL carries ?v=<content hash> (see _version_static in app.py),
# so the URL changes whenever the bytes change and these can be cached hard
# and indefinitely. Before versioning these were a week, which meant a photo
# replaced under the same filename kept serving stale at the edge for days.
/static/*
  Cache-Control: public, max-age=31536000, immutable

# Pages themselves are cheap and must reflect edits straight away.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
